<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_soccer_pitch"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFechaLugarPartido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jornada - fecha y lugar"
        android:textColor="@color/blanco"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvEquiposPartido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Equipo local vs Equipo visitante"
        android:textColor="@color/blanco"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAlineacionPartido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/blanco"
            android:text="Alineación"
            android:textColor="@color/verde_cancha" />

        <Button
            android:id="@+id/btnEliminarPartido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/rojo_estado"
            android:text="Eliminar"
            android:textColor="@color/blanco" />
    </LinearLayout>

</LinearLayout>